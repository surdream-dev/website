# Backend API
VITE_API_BASE_URL=https://api.surdream.com

# WalletConnect Cloud project ID. Required for WalletConnect connections; injected
# browser wallets (MetaMask, OKX, …) work without it. Get one at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Ethereum mainnet RPC. Comma-separate several endpoints to spread requests across a pool,
# so one dead endpoint degrades only a fraction of reads.
# Leave blank to use the public fallback: https://ethereum.publicnode.com
VITE_ETHEREUM_RPC_URL=

# Optional additional chains
VITE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
VITE_OPTIMISM_RPC_URL=https://mainnet.optimism.io
